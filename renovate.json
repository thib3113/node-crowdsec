{
  "extends": [
    "config:js-lib",
    "docker:pinDigests",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":prNotPending",
    ":disableRateLimiting",
    ":ignoreModulesAndTests",
    ":pinDevDependencies",
    "helpers:pinGitHubActionDigests",
    ":enableVulnerabilityAlerts",
    "group:monorepos",
    "group:recommended",
    "workarounds:all"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["packages/crowdsec-mcp/Dockerfile"],
      "automerge": true
    }
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "assignees": ["thib3113"],
  "schedule": ["before 5am"]
}
