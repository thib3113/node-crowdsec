{
    "name": "crowdsec-mcp",
    "version": "0.1.0",
    "description": "Model Context Protocol server for CrowdSec",
    "type": "module",
    "main": "./dist/index.js",
    "bin": {
        "crowdsec-mcp": "./dist/index.js"
    },
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "homepage": "https://github.com/thib3113/node-crowdsec/tree/main/packages/crowdsec-mcp#readme",
    "bugs": {
        "url": "https://github.com/thib3113/node-crowdsec/issues?labels=crowdsec-mcp"
    },
    "author": {
        "email": "thib3113@gmail.com",
        "name": "Thibaut severac"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/thib3113/node-crowdsec.git"
    },
    "keywords": [
        "crowdsec",
        "mcp",
        "model-context-protocol",
        "security"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "prepack": "npm run build",
        "build": "rimraf dist && tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:ci": "vitest run",
        "test:ci:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "lint:fix": "npm run lint -- --fix",
        "ci:eslint": "npm run lint -- -f json -o ./coverage/eslint-report.json"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.32.2",
        "crowdsec-client": "workspace:^",
        "debug": "^4.4.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/debug": "4.1.13",
        "@types/node": "26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "rimraf": "6.1.3",
        "typescript": "6.0.3",
        "vitest": "5.0.5"
    }
}
