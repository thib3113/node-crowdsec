        "lint:packages": "publint packages/crowdsec-client && publint packages/crowdsec-http-middleware && publint packages/crowdsec-client-scenarios && publint packages/crowdsec-mcp",
        "lint:types": "attw --pack packages/crowdsec-client && attw --pack packages/crowdsec-http-middleware && attw --pack packages/crowdsec-client-scenarios && attw --pack packages/crowdsec-mcp",
        "typecheck": "pnpm -F \"./packages/**\" exec tsc --noEmit"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@typescript-eslint/parser": "8.73.0",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "prettier": "3.10.1",
        "publint": "0.3.25",
        "ts-node": "10.9.2",
        "typedoc": "0.28.20",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
