    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=9"
    },
    "license": "UNLICENSED",
    "scripts": {
        "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"examples/*/src/**/*.ts\" \"dev/**/*.ts\"",
        "generate:documentation": "typedoc",
        "lint:packages": "publint packages/crowdsec-client && publint packages/crowdsec-http-middleware && publint packages/crowdsec-client-scenarios && publint packages/crowdsec-mcp",
        "lint:types": "attw --pack packages/crowdsec-client && attw --pack packages/crowdsec-http-middleware && attw --pack packages/crowdsec-client-scenarios && attw --pack packages/crowdsec-mcp",
        "typecheck": "pnpm -F \"./packages/**\" exec tsc --noEmit"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@typescript-eslint/parser": "8.72.1",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "prettier": "3.9.10",
        "publint": "0.3.25",
        "ts-node": "10.9.2",
        "typedoc": "0.28.20",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
