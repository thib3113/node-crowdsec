        "lint:packages": "publint packages/crowdsec-client && publint packages/crowdsec-http-middleware && publint packages/crowdsec-client-scenarios && publint packages/crowdsec-mcp",
        "lint:types": "attw --pack packages/crowdsec-client && attw --pack packages/crowdsec-http-middleware && attw --pack packages/crowdsec-client-scenarios && attw --pack packages/crowdsec-mcp",
        "typecheck": "pnpm -F \"./packages/**\" exec tsc --noEmit"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@typescript-eslint/parser": "8.72.1",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "prettier": "3.9.10",
        "publint": "0.3.25",
        "ts-node": "10.9.2",
        "typedoc": "0.28.20",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
